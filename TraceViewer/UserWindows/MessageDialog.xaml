<Window x:Class="TraceViewer.UserWindows.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TraceViewer.UserWindows"
        mc:Ignorable="d"
        Title="MessageDialog"
        SizeToContent="Height"
        MinHeight="150"
        MaxHeight="600"
        Width="560"
        WindowStyle="None"
        BorderBrush="White"
        BorderThickness="0.5"
        ResizeMode="NoResize"
        Background="#0D0D0D"
        Topmost="True"
        >
    <Grid>
        <Grid Margin="18,25,18,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="450" Margin="0,0,0,15">
                <TextBlock x:Name="PromptText" 
                           Text="PROMPT" 
                           TextAlignment="Left" 
                           HorizontalAlignment="Stretch"
                           TextWrapping="Wrap" 
                           FontSize="13" 
                           LineHeight="20" 
                           Foreground="White"/>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Label Style="{StaticResource LabelButton}" x:Name="Ok" Padding="15,6,15,6" Content="OK" MouseDown="Ok_MouseDown">
                    <Label.Effect>
                        <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="15" Opacity="0.8"/>
                    </Label.Effect>
                </Label>
            </StackPanel>
        </Grid>
    </Grid>
</Window>