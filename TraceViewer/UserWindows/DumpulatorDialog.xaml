<Window x:Class="TraceViewer.UserWindows.DumpulatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:TraceViewer.UserControls"
        mc:Ignorable="d"
        Title="Dumpulator Bridge"
        WindowStyle="None"
        BorderBrush="White"
        BorderThickness="0.5"
        Background="#0D0D0D"
        Width="1080"
        Height="680"
        MinWidth="750"
        MinHeight="450"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark Title Bar -->
        <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown" Margin="0,0,0,5">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Label Style="{StaticResource InstructionsViewTitles}" Content="DUMPULATOR" FontSize="18" Padding="5,2,10,5" BorderThickness="0">
                        <Label.Effect>
                            <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="15" Opacity="0.8"/>
                        </Label.Effect>
                    </Label>
                    <TextBlock Text="PYTHON EMULATION BRIDGE" Foreground="#4EC9B0" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Label Style="{StaticResource LabelButton}" Content=" _ " Padding="10,4,10,4" Margin="2,0" MouseDown="MinimizeBtn_MouseDown">
                        <Label.Effect>
                            <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="15" Opacity="0.8"/>
                        </Label.Effect>
                    </Label>
                    <Label Style="{StaticResource LabelButton}" Content=" □ " Padding="10,4,10,4" Margin="2,0" MouseDown="MaximizeBtn_MouseDown">
                        <Label.Effect>
                            <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="15" Opacity="0.8"/>
                        </Label.Effect>
                    </Label>
                    <Label Style="{StaticResource LabelButton}" Content=" X " Padding="10,4,10,4" Margin="2,0" MouseDown="CloseBtn_MouseDown">
                        <Label.Effect>
                            <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="15" Opacity="0.8"/>
                        </Label.Effect>
                    </Label>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Divider Line -->
        <Line Grid.Row="1" Stroke="White" StrokeThickness="2" X1="0" Y1="0" X2="10000" Y2="0" Margin="0,0,0,8"/>

        <!-- Dumpulator Embedded Control -->
        <Border Grid.Row="2" BorderBrush="{StaticResource ViewBorderBrighterBrush}" BorderThickness="0.5">
            <uc:DumpulatorControl x:Name="DumpulatorMainControl"/>
        </Border>
    </Grid>
</Window>
