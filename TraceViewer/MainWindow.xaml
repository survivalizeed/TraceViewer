<Window x:Class="TraceViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TraceViewer"
        mc:Ignorable="d"
        Title="survivalizeed's Trace Viewer"
        Width="{x:Static SystemParameters.PrimaryScreenWidth}"
        Height="{x:Static SystemParameters.PrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        >
    <Grid Name="Window">
        <Rectangle Fill="{StaticResource PrimaryBackgroundBrush}"/>

        <ScrollViewer Name="MnemonicReaderScrollView" Visibility="Collapsed">
            <Label Name="MnemonicReader" FontSize="15" FontFamily="Miriam Mono CLM" Foreground="{StaticResource PrimaryForegroundBrush}" Background="{StaticResource DimmedBackgroundBrush}"
                   MouseDown="MnemonicReader_MouseDown"/>
        </ScrollViewer>


        <Grid Name="DropZone" Visibility="Hidden" Background="{StaticResource DimmedBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource InstructionsViewTitles}" Padding="2,5,2,10" FontSize="50" Content="DROP HERE" BorderThickness="0" Grid.Row="0">
                    <Label.Effect>
                        <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="15" Opacity="0.8"/>
                    </Label.Effect>
                </Label>
            </DockPanel>
        </Grid>

        <Canvas x:Name="DimmingOverlay" Background="Black" Opacity="0.3" Visibility="Collapsed" Panel.ZIndex="1000"/>

        <Grid Name="MainView" Visibility="Visible">
            <Grid Name="MenuView">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Menu ClipToBounds="False">
                            <MenuItem Header="FILE">
                                <MenuItem x:Name="OpenTrace" Header="Open Trace" Click="OpenTrace_Click"/>
                                <MenuItem x:Name="OpenProject_" Header="Open Project" Click="OpenProject_Click"/>
                                <MenuItem x:Name="SaveProject" Header="Save Project" Click="SaveProject_Click"/>
                                <MenuItem x:Name="SaveProjectAs" Header="Save Project As" Click="SaveProjectAs_Click"/>
                                <MenuItem x:Name="CloseProject" Header="Quit Project/Trace" Click="CloseProject_Click"/>
                            </MenuItem>
                            <MenuItem Header="ANALYZER">
                                <MenuItem x:Name="RemoveUselessAssignments" Header="Remove Useless Assignments" Click="RemoveUselessAssignments_Click"/>
                                <MenuItem x:Name="RemoveDeobfuscation" Header="Remove Deobfuscation" Click="RemoveDeobfuscation_Click"/>
                            </MenuItem>
                            <MenuItem Header="MEMORY">
                                <MenuItem x:Name="StackAlignmentBase" Header="Stack Alignment Base Address" Click="StackAlignmentBase_Click"/>
                                <MenuItem x:Name="StackAlignment" Header="Stack Alignment" Click="StackAlignment_Click"/>
                                <MenuItem x:Name="HeapAlignmentBase" Header="Heap Alignment Base Address" Click="HeapAlignmentBase_Click"/>
                                <MenuItem x:Name="HeapAlignment" Header="Heap Alignment" Click="HeapAlignment_Click"/>
                            </MenuItem>
                        </Menu>
                    </DockPanel>
                    <DockPanel Margin="0,30,0,0"  LastChildFill="False">
                        <Border x:Name="DisasmViewButtonBorder" Style="{StaticResource ViewTitlesBorder}">
                            <Label x:Name="DisasmViewButton" Content="DISASM" Foreground="{StaticResource PrimaryForegroundBrush}" Style="{StaticResource ViewTitles}" MouseDown="DisasmViewButton_MouseDown"/>
                        </Border>
                        <Border x:Name="NotesViewButtonBorder" Style="{StaticResource ViewTitlesBorder}">
                            <Label x:Name="NotesViewButton" Content="NOTES" Foreground="{StaticResource PrimaryForegroundBrush}" Style="{StaticResource ViewTitles}" MouseDown="NotesViewButton_MouseDown"/>
                        </Border>
                        <Border x:Name="BookmarksViewButtonBorder" Style="{StaticResource ViewTitlesBorder}">
                            <Label x:Name="BookmarksViewButton" Content="BOOKMARKS" Foreground="{StaticResource PrimaryForegroundBrush}" Style="{StaticResource ViewTitles}" MouseDown="BookmarksViewButton_MouseDown"/>
                        </Border>
                        <Border x:Name="GraphViewButtonBorder" Style="{StaticResource ViewTitlesBorder}">
                            <Label x:Name="GraphViewButton" Content="GRAPH" Foreground="{StaticResource PrimaryForegroundBrush}" Style="{StaticResource ViewTitles}" MouseDown="GraphViewButton_MouseDown"/>
                        </Border>
                    </DockPanel>
                    <Line Margin="0,0,0,0" X1="0" Y1="0" X2="10000" Y2="0" Stroke="{StaticResource PrimaryForegroundBrush}" StrokeThickness="5"/>
                </StackPanel>
            </Grid>

            <Grid Name="DisassemblerView">
                <DockPanel Margin="0,104,0,15" LastChildFill="False" Background="Transparent">
                    <DockPanel LastChildFill="False" Height="41" VerticalAlignment="Top" DockPanel.Dock="Left">
                        <Grid x:Name="TitlesGrid" DockPanel.Dock="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"  MinWidth="3" MaxWidth="80" Name="Cd0"/>
                                <ColumnDefinition Width="100" MinWidth="3" MaxWidth="130" Name="Cd1"/>
                                <ColumnDefinition Width="300" MinWidth="3" MaxWidth="450" Name="Cd2"/>
                                <ColumnDefinition Width="300" MinWidth="3" MaxWidth="600" Name="Cd3"/>
                                <ColumnDefinition Width="300" MinWidth="3" MaxWidth="500" Name="Cd4"/>
                                <ColumnDefinition Width="*" Name="Cd5"/>
                            </Grid.ColumnDefinitions>

                            <Label x:Name="Id" Style="{StaticResource InstructionsViewTitles}" Content="#" Grid.Column="0" SizeChanged="TitleLabel_SizeChanged" />
                            <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" />

                            <Label x:Name="Address" Style="{StaticResource InstructionsViewTitles}" Content="ADDRESS" Grid.Column="1" SizeChanged="TitleLabel_SizeChanged"/>
                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" />

                            <Label x:Name="Disasm" Style="{StaticResource InstructionsViewTitles}" Content="DISASM" Grid.Column="2" SizeChanged="TitleLabel_SizeChanged" />
                            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" />

                            <Label x:Name="Changes" Style="{StaticResource InstructionsViewTitles}" Content="CHANGES" Grid.Column="3" SizeChanged="TitleLabel_SizeChanged"/>
                            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" />

                            <Label x:Name="Comments" Style="{StaticResource InstructionsViewTitlesSelectable}" Content="COMMENTS" Grid.Column="4" SizeChanged="TitleLabel_SizeChanged"
                                   MouseDown="Comments_MouseDown"/>
                            <GridSplitter Grid.Column="4" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" />

                        </Grid>
                    </DockPanel>
                    <DockPanel LastChildFill="False" Height="41" VerticalAlignment="Top" DockPanel.Dock="Left" Margin="29.2,0,0,0">
                        <Label x:Name="Fpu" Style="{StaticResource InstructionsViewTitlesSelectable}" Content="    FPU    " MouseDown="Fpu_MouseDown"/>
                    </DockPanel>
                </DockPanel>
                <DockPanel Margin="0,150,0,10" LastChildFill="True">
                    <Grid x:Name="InstructionsViewGrid" DockPanel.Dock="Left">
                        <ItemsControl x:Name="InstructionsView" VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer Name="InstructionsViewScrollViewer" CanContentScroll="False"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="InstructionsScrollViewer_PreviewMouseWheel">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                        </ItemsControl>
                    </Grid>
                    <Grid Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="400"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="325"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0.5" BorderBrush="{StaticResource ViewBorderBrush}">
                            <Grid x:Name="RegistersViewGrid" Grid.Row="0" Margin="7,4,0,0">
                                <ItemsControl x:Name="RegistersView" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer CanContentScroll="True">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Label x:Name="StackHeapToggle" Grid.Row="1" Margin="0,5,0,5" HorizontalAlignment="Left"
                               Style="{StaticResource InstructionsViewTitlesSelectable}" FontSize="12" Content="  STACK  " Width="Auto"
                               MouseDown="StackHeapToggle_MouseDown"/>
                        <Grid x:Name="MemoryViewGrid" Grid.Row="2" Margin="0,0,0,0">
                            <Border Name="StackBorderParent" BorderThickness="0.5" BorderBrush="{StaticResource ViewBorderBrush}" Visibility="Visible">
                                <ScrollViewer Name="StackScroller" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Name="Stack" Style="{StaticResource DisasmTextBlock}" Text="" FontSize="13" TextWrapping="Wrap"
                                               VerticalAlignment="Top" Background="Transparent" />
                                </ScrollViewer>
                            </Border>
                            <Border Name="HeapBorderParent" BorderThickness="0.5" BorderBrush="{StaticResource ViewBorderBrush}" Visibility="Collapsed">
                                <ScrollViewer Name="HeapScroller" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Name="Heap" Style="{StaticResource DisasmTextBlock}" Text="" FontSize="13" TextWrapping="Wrap"
                                               VerticalAlignment="Top" Background="Transparent" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Grid>

            <Grid Name="NotesView">
                <Border Margin="0,104,0,15" BorderThickness="0.5" BorderBrush="{StaticResource ViewBorderBrush}">
                    <TextBox Name="NotesContent" Text="" Foreground="{StaticResource PrimaryForegroundBrush}" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="{StaticResource DimmedBackgroundBrush}" FontSize="15" FontFamily="Consolas"
                             BorderThickness="0"/>
                </Border>
            </Grid>

            <Grid Name="BookmarksView">
                <Border Margin="0,104,0,15" BorderThickness="0.5" BorderBrush="{StaticResource ViewBorderBrush}">

                </Border>
            </Grid>
            
            <Grid Name="GraphView">
                <Border Margin="0,104,0,15" BorderThickness="0.5" BorderBrush="{StaticResource ViewBorderBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="GraphViewCanvas" Background="{StaticResource LightDimmedBackgroundBrush}" ClipToBounds="True"/>
                    </ScrollViewer>
                </Border>
            </Grid>
            
        </Grid>
    </Grid>
</Window>