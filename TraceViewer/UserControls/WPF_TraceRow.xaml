<UserControl x:Class="TraceViewer.WPF_TraceRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TraceViewer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MouseEnter="OnRowMouseEnter"
             MouseMove="OnRowMouseMove"
             >
    <UserControl.Resources>
        <ContextMenu x:Key="ContextMenu" Style="{StaticResource DisasmContextMenu}" Opened="ContextMenu_Opened" Closed="ContextMenu_Closed" StaysOpen="False">
            <MenuItem Name="ShowOrRemove" Header="Show/Remove" Click="ShowOrRemove_Click"/>
            <MenuItem Name="Copy" Header="Copy" Click="Copy_Click"/>
            <MenuItem Name="CopyRow" Header="Copy Row" Click="CopyRow_Click"/>
            <MenuItem Name="MarkUnmarkAsBlockStart" Header="Mark As Block Start..." Click="MarkUnmarkAsBlockStart_Click"/>
            <MenuItem Name="RenameBlockMenuItem" Header="Rename Block..." Click="RenameBlock_Click" Visibility="Collapsed"/>
            <MenuItem Name="AddOrRemoveBookmark" Header="Add/Remove Bookmark" Click="AddOrRemoveBookmark_Click"/>
            <MenuItem Name="BackwardSlice" Header="Backward Slice (Isolate Dependencies)" Click="BackwardSlice_Click"/>
            <MenuItem Name="ClearSliceFilter" Header="Clear Slice Filter" Click="ClearSliceFilter_Click" Visibility="Collapsed"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Margin="0,0,0,0" ContextMenu="{StaticResource ContextMenu}">
        <StackPanel Orientation="Vertical">
            <StackPanel x:Name="block_panel" Orientation="Vertical" Visibility="Collapsed" Margin="0,5,0,3">
                <TextBox x:Name="block" 
                         Style="{StaticResource CommentsTextBox}" 
                         HorizontalAlignment="Center" 
                         HorizontalContentAlignment="Center" 
                         FontSize="14" 
                         FontWeight="Bold" 
                         FontFamily="Consolas" 
                         Padding="40,3,40,3" 
                         BorderThickness="0.5" 
                         BorderBrush="{StaticResource ViewBorderBrighterBrush}"
                         CaretBrush="{StaticResource PrimaryForegroundBrush}"
                         ContextMenu="{StaticResource ContextMenu}"
                         MouseDoubleClick="block_MouseDoubleClick"
                         PreviewKeyDown="block_PreviewKeyDown"
                         GotFocus="block_GotFocus"
                         LostFocus="block_LostFocus"
                         TextChanged="block_TextChanged"/>
                <Rectangle Height="1" HorizontalAlignment="Stretch" Fill="{StaticResource ViewBorderHoverBrush}" Margin="0,4,0,4"/>
            </StackPanel>
            <Grid x:Name="parent_panel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="col0" Width="45"/>
                    <ColumnDefinition x:Name="col1" Width="110"/>
                    <ColumnDefinition x:Name="col2" Width="320"/>
                    <ColumnDefinition x:Name="col3" Width="320"/>
                    <ColumnDefinition x:Name="col4" Width="320"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="id_border" Grid.Column="0" Style="{StaticResource DisasmTextBlockBorder}">
                    <TextBlock x:Name="id" Style="{StaticResource DisasmTextBlock}"/>
                </Border>
                <Border x:Name="address_border" Grid.Column="1" Style="{StaticResource DisasmTextBlockBorder}">
                    <TextBlock x:Name="address" Style="{StaticResource DisasmTextBlock}"/>
                </Border>
                <Border x:Name="disasm_border" Grid.Column="2" Style="{StaticResource DisasmTextBlockBorder}">
                    <TextBlock x:Name="disasm" Style="{StaticResource DisasmTextBlock}" MouseDown="disasm_MouseDown"/>
                </Border>
                <Border x:Name="changes_border" Grid.Column="3" Style="{StaticResource DisasmTextBlockBorder}">
                    <TextBlock x:Name="changes" Style="{StaticResource DisasmTextBlock}"/>
                </Border>
                <Grid Grid.Column="4">
                    <TextBox Visibility="Collapsed" Style="{StaticResource CommentsTextBox}" x:Name="mnemonicBrief" HorizontalContentAlignment="Center" IsReadOnly="True"
                             MouseDoubleClick="OnDoubleClickMnemonic" KeyDown="OnKeyPressMnemonic"/>
                    <TextBox Style="{StaticResource CommentsTextBox}" x:Name="comments" HorizontalContentAlignment="Center" 
                             PreviewKeyDown="PreviewOnKeyPressComments" TextChanged="TextChangedComments"/>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>