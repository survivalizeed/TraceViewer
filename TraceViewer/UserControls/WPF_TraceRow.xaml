<UserControl x:Class="TraceViewer.WPF_TraceRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TraceViewer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >
    <UserControl.Resources>
        <ContextMenu x:Key="ContextMenu" Style="{StaticResource DisasmContextMenu}" Opened="ContextMenu_Opened" Closed="ContextMenu_Closed" StaysOpen="False">
            <MenuItem Name="ShowOrRemove" Header="Show/Remove" PreviewMouseDown="ShowOrRemove_PreviewMouseDown"/>
            <MenuItem Name="Copy" Header="Copy" PreviewMouseDown="Copy_PreviewMouseDown"/>
            <MenuItem Name="CopyRow" Header="Copy Row" PreviewMouseDown="CopyRow_PreviewMouseDown"/>
            <MenuItem Name="AddBookmark" Header="Add Bookmark" PreviewMouseDown="AddBookmark_PreviewMouseDown"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Margin="0,0,0,0" >
        <StackPanel Orientation="Vertical">
            <StackPanel x:Name="block_panel" Orientation="Vertical" Visibility="Collapsed">
                <TextBlock x:Name="block" Style="{StaticResource DisasmTextBlock}" Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <Line Margin="0,0,0,5" X1="0" Y1="0" X2="10000" Y2="0" Stroke="{StaticResource ViewBorderHoverBrush}" StrokeThickness="1"/>
            </StackPanel>
            <DockPanel x:Name="parent_panel" LastChildFill="False">
                <Border x:Name="id_border" Style="{StaticResource DisasmTextBlockBorder}" Width="50" DockPanel.Dock="Left">
                    <TextBlock x:Name="id" Width="50" Style="{StaticResource DisasmTextBlock}" DockPanel.Dock="Left" MouseEnter="OnHover" ContextMenu="{StaticResource ContextMenu}"/>
                </Border>
                <Border x:Name="address_border" Style="{StaticResource DisasmTextBlockBorder}" Width="100" DockPanel.Dock="Left">
                    <TextBlock x:Name="address" Width="100" Style="{StaticResource DisasmTextBlock}" DockPanel.Dock="Left" MouseEnter="OnHover" ContextMenu="{StaticResource ContextMenu}"/>
                </Border>
                <Border x:Name="disasm_border" Style="{StaticResource DisasmTextBlockBorder}" Width="300" DockPanel.Dock="Left">
                    <TextBlock x:Name="disasm" Width="300" Style="{StaticResource DisasmTextBlock}" DockPanel.Dock="Left" MouseEnter="OnHover" MouseDown="disasm_MouseDown" ContextMenu="{StaticResource ContextMenu}"/>
                </Border>
                <Border x:Name="changes_border" Style="{StaticResource DisasmTextBlockBorder}" Width="300" DockPanel.Dock="Left">
                    <TextBlock x:Name="changes" Width="300" Style="{StaticResource DisasmTextBlock}" DockPanel.Dock="Left" MouseEnter="OnHover" ContextMenu="{StaticResource ContextMenu}"/>
                </Border>
                <TextBox Visibility="Collapsed" Style="{StaticResource CommentsTextBox}" x:Name="mnemonicBrief" HorizontalContentAlignment="Center" Width="300" DockPanel.Dock="Left" MouseEnter="OnHover" IsReadOnly="True"
                     MouseDoubleClick="OnDoubleClickMnemonic" KeyDown="OnKeyPressMnemonic"/>
                <TextBox Style="{StaticResource CommentsTextBox}" x:Name="comments" HorizontalContentAlignment="Center" Width="300" DockPanel.Dock="Left" MouseEnter="OnHover" 
                     PreviewKeyDown="PreviewOnKeyPressComments" TextChanged="TextChangedComments"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>